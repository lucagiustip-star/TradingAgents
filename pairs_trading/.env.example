# Alpaca PAPER TRADING credentials for the pairs-trading system.
#
# Copy this file to `.env` at the REPOSITORY ROOT (not inside pairs_trading/):
#
#     cp pairs_trading/.env.example .env
#
# Get PAPER keys from https://app.alpaca.markets/paper/dashboard/overview
# (Paper keys are distinct from live keys. Generating them does not require a
# funded account.)
#
# This project has no live-trading code path: the base URL is validated at
# config load, re-validated before the client is built, read back off the
# constructed client, and the SDK is always given paper=True as a literal.
# Pointing these keys at a live account will not enable live trading -- it will
# fail the endpoint check and abort.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# The endpoint lives in pairs_trading/config.yaml (execution.base_url) and must
# contain "paper". It is listed here only so the value is visible in one place:
#
#     https://paper-api.alpaca.markets
#
# The older APCA_* spellings are also accepted if you already have them set:
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=

# ---------------------------------------------------------------------------
# Risk alerting (optional).
#
# The risk layer sends a notification on every circuit-breaker trip, kill-switch
# activation and risk rejection. Alerts always go to the application log; email
# is added on top when SMTP_HOST and SMTP_TO are set below.
#
# Leaving these blank is fine -- alerting degrades to log-only rather than
# failing. A dead mail server never blocks a halt or a kill switch.
#
# To add SMS or Slack later, subclass AlertChannel in risk_manager.py and add it
# to the dispatcher; no calling code changes.
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=              # app password, not your account password
# SMTP_FROM=you@gmail.com
# SMTP_TO=you@gmail.com       # comma-separated for several recipients
# SMTP_USE_TLS=true
