{
  "name": "TradingAgents — pairs trading",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // Installs the pinned pairs-trading stack (numpy, pandas, statsmodels,
  // yfinance, matplotlib, alpaca-py) so the container is ready to run the
  // moment it finishes building. Nothing to install by hand.
  "postCreateCommand": "pip install --no-cache-dir -r pairs_trading/requirements.txt && python -m pairs_trading.main --help > /dev/null && echo 'Ready. Next: python -m pairs_trading.main --init-env'",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests/test_pairs_trading.py",
          "tests/test_risk_manager.py",
          "tests/test_dashboard.py",
          "tests/test_news_guard.py"
        ]
      }
    }
  },

  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  },

  // Alpaca credentials.
  //
  // In a Codespace, prefer repository Codespaces secrets over a .env file:
  //   GitHub -> repo Settings -> Secrets and variables -> Codespaces
  //   Add ALPACA_API_KEY and ALPACA_SECRET_KEY
  //
  // They arrive as real environment variables, which this project reads in
  // preference to .env, and they survive a container rebuild -- a .env written
  // inside the container does not, since the container is disposable.
  //
  // Use PAPER keys. There is no live-trading code path in this project.
  "remoteUser": "vscode"
}
